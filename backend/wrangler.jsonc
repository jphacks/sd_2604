			"database_id": "28ccd620-3c03-4b90-b3c2-7a9900833224"
		}
	],
	"kv_namespaces": [
		{
			"binding": "meetpoint_rooms",
			"id": "5adc26695ab243ef9cd74a8066137ec6"
		}
	]
